FROM mirror.gcr.io/library/ubuntu:22.04

WORKDIR /usr/src/app

ARG APK_COMPS="cmake gcc-arm-none-eabi"
ARG APK_PYTHON="python3 python3-pip"
ARG APK_MISC="make git diffutils zip"
ARG APK_DEV="musl-dev clang clang-tools shellcheck"

ARG PIP_PKGS='mkdocs click cryptography cbor intelhex pyyaml'

RUN apt-get update && apt-get install -y \
    ${APK_COMPS} ${APK_PYTHON} ${APK_MISC} ${APK_DEV}

RUN python3 -m pip install ${PIP_PKGS}
